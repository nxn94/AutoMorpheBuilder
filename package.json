{
  "name": "auto-morphe-builder",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "jest --forceExit",
    "lint": "eslint .github/scripts",
    "validate:config": "node scripts/validate-config.js",
    "validate:agent-docs": "node scripts/check-agents-doc.js",
    "check": "npm run lint && npm test && npm run validate:config && npm run validate:agent-docs"
  },
  "jest": {
    "coverageThreshold": {
      "./src/errors/": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      },
      "./src/apk/candidate.js": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      },
      "./src/archive/": {
        "branches": 85,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "playwright": "1.58.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.9.1",
    "jest": "^30.4.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.6",
    "js-yaml": "^5.2.3"
  }
}
